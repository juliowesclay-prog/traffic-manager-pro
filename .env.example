# Copiado para .env por `pnpm env:init` (que também gera senhas e chaves aleatórias). Nunca versionar o .env.
APP_ENV=development
APP_URL=http://localhost:3300

# PostgreSQL local (infra/docker-compose.yml) — porta 5436 para não colidir com outros projetos
POSTGRES_USER=tmp
POSTGRES_PASSWORD=__GERADA__
POSTGRES_DB=traffic_manager_dev
POSTGRES_PORT=5436
DATABASE_URL=postgresql://tmp:__GERADA__@localhost:5436/traffic_manager_dev?schema=public

# Proteção de dados (LGPD): chaves de 32 bytes em base64, geradas por `pnpm env:init`.
# Em produção, vêm do cofre de segredos. Trocar a chave exige recifrar os dados (token da Meta e MFA).
DATA_ENCRYPTION_KEY=__CHAVE32__
HASH_PEPPER=__CHAVE32__

# Opcional, só testes locais: "true" preenche o login do administrador de demonstração em /admin/entrar
# (apenas quando aberto por localhost). Ignorado e proibido em produção.
DEV_PREFILL_LOGIN=

# Primeiro superadministrador (pnpm db:seed). O autenticador (MFA) é configurado no primeiro acesso.
SEED_ADMIN_EMAIL=admin@trafficmanager.test
SEED_ADMIN_PASSWORD=__SENHA__

# Usuários e empresa de DEMONSTRAÇÃO (pnpm db:seed:demo) — somente desenvolvimento/testes.
DEMO_USER_PASSWORD=__SENHA__
DEMO_MFA_SECRET=__TOTP__

# Quantos proxies confiáveis ficam na frente do site (balanceador, CDN). Define de onde vem o IP
# do visitante no X-Forwarded-For. 0 = ignorar o cabeçalho (seguro por padrão).
TRUST_PROXY_HOPS=0
# Em produção, 0 só é aceito com TRUST_PROXY_NONE=true (site recebe o visitante direto, sem proxy).

# Segredo da rotina periódica (pnpm worker / agendador da hospedagem).
CRON_SECRET=__CHAVE32__

# Meta (Facebook/Instagram Ads). META_PROVIDER: "simulado" (desenvolvimento, contas DEMO) ou "meta".
# O app da Meta (ID e segredo) vem do painel developers.facebook.com; o segredo fica só aqui ou no cofre.
META_PROVIDER=simulado
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v24.0
# Opcional: configuração do "Login do Facebook para Empresas" (substitui a lista de permissões).
META_LOGIN_CONFIG_ID=

# IA analista. AI_PROVIDER: "simulado" (regras fixas, DEMO) ou "claude".
# A chave da API do Claude fica só aqui ou no cofre da hospedagem. Só números agregados vão para a IA.
AI_PROVIDER=simulado
ANTHROPIC_API_KEY=
# Opcional: modelo (padrão claude-opus-5-5).
AI_MODEL=
